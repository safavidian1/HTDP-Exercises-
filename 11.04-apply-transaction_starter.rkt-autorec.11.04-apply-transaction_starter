#|PROBLEM B:
Design a function "apply-transaction" that consumes an Account and a Transaction 
and produces the balance(amount) of the given Account after the transaction has been applied.

For example:
| my-account | action                             | result|
| $100       | (make-withdraw 10)                 | $90   |
| $90        | (make-deposit 30)                  | $120  |
| $50        | (make-transfer my-account joes 20) | $30   |
| $10        | (make-transfer joes my-account 30) | $40   |
|#

; apply-transaction : (Account Transaction -> Account)
; produce the given account updated with the transaction applied to it based on the table abo
(check-expect (apply-transaction joe-acc xfer) (make-account "joe" 0))
(check-expect (apply-transaction joe-acc dep) (make-account "joe" 195))
(check-expect (apply-transaction joe-acc wd) (make-account "joe" 65))
(check-expect (apply-transaction joe-acc (make-transfer joe-acc li-acc 30)) (make-account "joe" 45))

;(define (apply-transaction joe-acc wd) (make "joe" 0)) ;stub

(define (apply-transaction acc tx)
   (cond
     [(deposit? tx)
      (make-account
       (account-name acc)
       (+ (deposit-amount tx) (account-balance acc)))]
     [(withdraw? tx)
      (make-account
       (account-name acc)
       (- (account-balance acc) (withdraw-amount tx)))]
     [(transfer? tx)
      (make-account
       (account-name acc) 
      (if (string=? (account-name acc) (account-name (transfer-from tx)))
          (- (account-balance (transfer-from tx)) (transfer-amount tx))
          (+ (account-balance (transfer-to tx)) (transfer-amount tx)))
          )])) 